<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
</head>
<body>
    <nav><a href="{{baseurl}}/archives.html">Archives</a> <a href="{{baseurl}}/category-code.html">Code</a> <a href="{{baseurl}}/about.html">About</a></nav>
    <h1>{{ title }}</h1>
    {{#if draft}}<p class="draft">Draft</p>{{/if}}
    <p class="date">{{date_format date}} &middot; {{ category }}</p>
    {{{ body }}}
    {{#if comments}}
    <section class="comments">
        <h2>Comments</h2>
        {{#each comments}}
        <article class="comment">
            <p>{{#if url}}<a href="{{url}}">{{author}}</a>{{else}}{{author}}{{/if}} &middot; {{date_format date}}</p>
            {{{content}}}
        </article>
        {{/each}}
    </section>
    {{/if}}
    <nav class="prev-next">
        {{#if prev}}<a href="{{prev}}">&larr; {{prev-title}}</a>{{/if}}
        {{#if next}}<a href="{{next}}">{{next-title}} &rarr;</a>{{/if}}
    </nav>
</body>
</html>
