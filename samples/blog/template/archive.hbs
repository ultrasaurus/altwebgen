<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ title }}</title>
</head>
<body>
    <nav><a href="/archives.html">Archives</a> <a href="/category-code.html">Code</a> <a href="/about.html">About</a></nav>
    <h1>{{ title }}</h1>
    {{#each posts_by_month}}
    <h2>{{date_format month}}</h2>
    <ul>
        {{#each posts}}
        <li><a href="{{url}}">{{title}}</a> <span class="date">{{date_format date "%b %-d"}}</span>{{#if draft}} <span class="draft">Draft</span>{{/if}}</li>
        {{/each}}
    </ul>
    {{/each}}
</body>
</html>
